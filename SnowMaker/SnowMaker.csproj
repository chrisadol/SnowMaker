<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;</TargetFrameworks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>SnowMakerCore</PackageId>
    <Description>netstandard1.3, netstandard2.0, netstandard2.1 version of SnowMaker</Description>
    <Authors>Tatham Oddie, Chris Adol</Authors>
    <PackageProjectUrl>https://github.com/chrisadol/SnowMaker/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chrisadol/SnowMaker/</RepositoryUrl>
    <Version>2.0.0-beta</Version>
    <AssemblyVersion>2.0.0</AssemblyVersion>
    <PackageReleaseNotes>Updated integration tests
Fixed intermittent failure of integration test by using static ConcurrentDictionary and further semaphores
Migrated to supported Azure.Storage.Blobs package</PackageReleaseNotes>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
    <FileVersion>2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.DiaSymReader.Native" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Azure.Storage.Blobs">
      <Version>12.14.1</Version>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="Azure.Storage.Blobs">
      <Version>12.14.1</Version>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard1.3'">
    <DefineConstants>TARGETTING_NETSTANDARD</DefineConstants>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <DefineConstants>TARGETTING_NETSTANDARD</DefineConstants>
    <PackageLicenseExpression>MS-PL</PackageLicenseExpression>
  </PropertyGroup>
</Project>